# Sexy Bash Prompt, inspired by “Extravagant Zsh Prompt”
# Shamelessly copied from https://github.com/gf3/dotfiles

default_username='notme'

if [[ $COLORTERM = gnome-* && $TERM = xterm ]] && infocmp gnome-256color >/dev/null 2>&1; then
  export TERM=gnome-256color
elif infocmp xterm-256color >/dev/null 2>&1; then
  export TERM=xterm-256color
fi

if tput setaf 1 &> /dev/null; then
  tput sgr0
  if [[ $(tput colors) -ge 256 ]] 2>/dev/null; then
    MAGENTA=$(tput setaf 9)
    ORANGE=$(tput setaf 172)
    GREEN=$(tput setaf 190)
    PURPLE=$(tput setaf 141)
    WHITE=$(tput setaf 15)
    CYAN=$(tput setaf 81)
    PINK=$(tput setaf 197)
  else
    MAGENTA=$(tput setaf 5)
    ORANGE=$(tput setaf 4)
    GREEN=$(tput setaf 2)
    PURPLE=$(tput setaf 1)
    WHITE=$(tput setaf 7)
  fi
  BOLD=$(tput bold)
  UNDERLINE=$(tput smul)
  NO_UNDERLINE=$(tput rmul)
  RESET=$(tput sgr0)
else
  MAGENTA="\033[1;31m"
  ORANGE="\033[1;33m"
  GREEN="\033[1;32m"
  PURPLE="\033[1;35m"
  WHITE="\033[1;37m"
  BOLD=""
  RESET="\033[m"
fi


function _pr_url_for_branch() {
  local cache_dir="/tmp/bash_pr_cache"
  local branch="$1"
  [ -z "$branch" ] && return

  local cache_key=$(echo -n "$(git rev-parse --show-toplevel):${branch}" | md5)
  local cache_file="${cache_dir}/${cache_key}"

  # Read from cache if it exists (instant)
  if [ -f "$cache_file" ]; then
    cat "$cache_file"
  fi

  # Only refresh if cache is missing or older than 5 minutes
  if [ ! -f "$cache_file" ] || [ $(( $(date +%s) - $(stat -f %m "$cache_file") )) -gt 300 ]; then
    mkdir -p "$cache_dir"
    ( gh pr view --json url,number -q '"\(.url) \(.number)"' > "${cache_file}" 2>/dev/null || echo -n > "${cache_file}" ) &
    disown 2>/dev/null
  fi
}

function git_info() {
  # check if we're in a git repo
  git rev-parse --is-inside-work-tree &>/dev/null || return

  # quickest check for what branch we're on
  branch=$(git symbolic-ref -q HEAD | sed -e 's|^refs/heads/||')

  # check if it's dirty (via github.com/sindresorhus/pure)
  dirty=$(git diff --quiet --ignore-submodules HEAD &>/dev/null; [ $? -eq 1 ]&& echo -e "*")

  local osc_open=$'\e]8;;'
  local osc_close=$'\e\\'
  local links=""

  # PR link from cache
  pr_cache=$(_pr_url_for_branch "$branch")
  if [ -n "$pr_cache" ]; then
    pr_url=$(echo "$pr_cache" | awk '{print $1}')
    pr_num=$(echo "$pr_cache" | awk '{print $2}')
    links="${CYAN}${UNDERLINE}${osc_open}${pr_url}${osc_close}PR #${pr_num}${osc_open}${osc_close}${NO_UNDERLINE}"
  fi

  # Linear ticket link extracted from branch name
  linear_id=$(echo "$branch" | grep -oiE '[a-z]+-[0-9]+' | head -1 | tr '[:lower:]' '[:upper:]')
  if [ -n "$linear_id" ]; then
    linear_link="${PINK}${UNDERLINE}${osc_open}https://linear.app/replo/issue/${linear_id}${osc_close}${linear_id}${osc_open}${osc_close}${NO_UNDERLINE}"
    if [ -n "$links" ]; then
      links="${links}, ${linear_link}"
    else
      links="${linear_link}"
    fi
  fi

  pr_info=""
  if [ -n "$links" ]; then
    pr_info="${WHITE} (${links})"
  fi

  echo -e $WHITE" on "$PURPLE$branch$dirty$pr_info
}

# Only show username/host if not default
function usernamehost() {
  if [ $USER != $default_username ]; then echo "${ORANGE}$USER ${WHITE}in "; fi
}

# iTerm Tab and Title Customization and prompt customization
# http://sage.ucsc.edu/xtal/iterm_tab_customization.html

# Put the string " [bash]   hostname::/full/directory/path"
# in the title bar using the command sequence
# \[\e]2;[bash]   \h::\]$PWD\[\a\]

# Put the penultimate and current directory
# in the iterm tab
# \[\e]1;\]$(basename $(dirname $PWD))/\W\[\a\]

PS1="\[\e]2;$PWD\[\a\]\[\e]1;\]$(basename "$(dirname "$PWD")")/\W\[\a\]${BOLD}\$(usernamehost)\[$GREEN\]\w\$(git_info)\[$WHITE\]\n\$ \[$RESET\]"
